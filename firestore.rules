rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Common Helpers
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Role verification: check bootstrapped admin email or database admin record
    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email_verified == true && request.auth.token.email == 'admin@example.com') ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Validation Helpers
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'role']) &&
             data.keys().hasOnly(['uid', 'email', 'displayName', 'photoURL', 'role', 'createdAt', 'updatedAt']) &&
             data.uid is string && data.uid.size() <= 128 && data.uid == request.auth.uid &&
             data.email is string && data.email.size() <= 256 &&
             data.role in ['user', 'admin'] &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 150)) &&
             (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 1000));
    }

    function isValidAdmin(data) {
      return data.keys().hasAll(['uid', 'email']) &&
             data.keys().hasOnly(['uid', 'email', 'assignedAt']) &&
             data.uid is string && data.uid.size() <= 128 &&
             data.email is string && data.email.size() <= 256;
    }

    function isValidInquiry(data) {
      return data.keys().hasAll(['userName', 'userEmail', 'destinationTitle', 'status']) &&
             data.keys().hasOnly([
               'userId', 'userName', 'userEmail', 'userPhone',
               'destinationTitle', 'packageTitle', 'travelDates',
               'travelerCount', 'notes', 'adminNotes', 'status',
               'createdAt', 'updatedAt'
             ]) &&
             data.userName is string && data.userName.size() > 0 && data.userName.size() <= 150 &&
             data.userEmail is string && data.userEmail.size() > 0 && data.userEmail.size() <= 256 &&
             data.destinationTitle is string && data.destinationTitle.size() <= 150 &&
             data.status in ['pending', 'reviewed', 'confirmed', 'cancelled'] &&
             (!('userId' in data) || (data.userId is string && data.userId.size() <= 128)) &&
             (!('userPhone' in data) || (data.userPhone is string && data.userPhone.size() <= 50)) &&
             (!('packageTitle' in data) || (data.packageTitle is string && data.packageTitle.size() <= 150)) &&
             (!('travelDates' in data) || (data.travelDates is string && data.travelDates.size() <= 100)) &&
             (!('travelerCount' in data) || (data.travelerCount is number && data.travelerCount >= 1 && data.travelerCount <= 100)) &&
             (!('notes' in data) || (data.notes is string && data.notes.size() <= 2000)) &&
             (!('adminNotes' in data) || (data.adminNotes is string && data.adminNotes.size() <= 2000));
    }

    function isValidBookmark(data) {
      return data.keys().hasAll(['destinationId', 'title']) &&
             data.keys().hasOnly(['destinationId', 'title', 'location', 'imageUrl', 'createdAt']) &&
             data.destinationId is string && data.destinationId.size() <= 128 &&
             data.title is string && data.title.size() <= 150 &&
             (!('location' in data) || (data.location is string && data.location.size() <= 150)) &&
             (!('imageUrl' in data) || (data.imageUrl is string && data.imageUrl.size() <= 1000));
    }

    // 1. Users collection
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(userId) && isOwner(userId) && isValidUser(incoming()) &&
                    (incoming().role == 'user' || (incoming().role == 'admin' && isAdmin()));
      allow update: if isValidId(userId) && isOwner(userId) && isValidUser(incoming()) &&
                    (incoming().role == existing().role || isAdmin());
      allow delete: if isValidId(userId) && (isOwner(userId) || isAdmin());

      // Bookmarks subcollection
      match /bookmarks/{bookmarkId} {
        allow get: if isValidId(bookmarkId) && (isOwner(userId) || isAdmin());
        allow list: if isOwner(userId) || isAdmin();
        allow create: if isValidId(bookmarkId) && isOwner(userId) && isValidBookmark(incoming());
        allow update: if isValidId(bookmarkId) && isOwner(userId) && isValidBookmark(incoming());
        allow delete: if isValidId(bookmarkId) && (isOwner(userId) || isAdmin());
      }
    }

    // 2. Admins collection
    match /admins/{adminId} {
      allow get: if isValidId(adminId) && isAdmin();
      allow list: if isAdmin();
      allow create, update, delete: if isValidId(adminId) && isAdmin() && isValidAdmin(incoming());
    }

    // 3. Inquiries collection
    match /inquiries/{inquiryId} {
      allow get: if isValidId(inquiryId) && (
        isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid)
      );
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isValidId(inquiryId) && isValidInquiry(incoming()) && (
        !('userId' in incoming()) || incoming().userId == '' || (isSignedIn() && incoming().userId == request.auth.uid)
      );
      allow update: if isValidId(inquiryId) && (
        isAdmin() ||
        (isSignedIn() && resource.data.userId == request.auth.uid && existing().status == 'pending' && isValidInquiry(incoming()))
      );
      allow delete: if isValidId(inquiryId) && isAdmin();
    }

    // 4. Connection test document
    match /test/{testId} {
      allow get: if isValidId(testId);
    }
  }
}
