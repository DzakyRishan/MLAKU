{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile document for MLAKU travelers and administrators",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 256 },
        "displayName": { "type": "string", "maxLength": 150 },
        "photoURL": { "type": "string", "maxLength": 1000 },
        "role": { "type": "string", "enum": ["user", "admin"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "role"]
    },
    "Admin": {
      "title": "Admin",
      "description": "Marker record for authorized administrators",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 256 },
        "assignedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email"]
    },
    "Inquiry": {
      "title": "Inquiry",
      "description": "Travel consultation and booking inquiry submitted by a traveler",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "userName": { "type": "string", "maxLength": 150 },
        "userEmail": { "type": "string", "maxLength": 256 },
        "userPhone": { "type": "string", "maxLength": 50 },
        "destinationTitle": { "type": "string", "maxLength": 150 },
        "packageTitle": { "type": "string", "maxLength": 150 },
        "travelDates": { "type": "string", "maxLength": 100 },
        "travelerCount": { "type": "number" },
        "notes": { "type": "string", "maxLength": 2000 },
        "adminNotes": { "type": "string", "maxLength": 2000 },
        "status": { "type": "string", "enum": ["pending", "reviewed", "confirmed", "cancelled"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userName", "userEmail", "destinationTitle", "status"]
    },
    "Bookmark": {
      "title": "Bookmark",
      "description": "Saved favorite destination for a user",
      "type": "object",
      "properties": {
        "destinationId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 150 },
        "location": { "type": "string", "maxLength": 150 },
        "imageUrl": { "type": "string", "maxLength": 1000 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["destinationId", "title"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Stores user profiles with role attribution"
    },
    "/admins/{adminId}": {
      "schema": "Admin",
      "description": "Registry of system administrators"
    },
    "/inquiries/{inquiryId}": {
      "schema": "Inquiry",
      "description": "Stores travel booking and bespoke itinerary inquiries"
    },
    "/users/{userId}/bookmarks/{bookmarkId}": {
      "schema": "Bookmark",
      "description": "Stores saved destinations bookmarked by the user"
    },
    "/test/{testId}": {
      "schema": "Bookmark",
      "description": "Connection test path"
    }
  }
}
